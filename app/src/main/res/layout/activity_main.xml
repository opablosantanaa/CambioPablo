<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/screen_glow">
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="28dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/field_glass" android:padding="10dp" android:src="@drawable/ic_exchange" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
          <TextView style="@style/Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" />
          <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_seu_dinheiro_em_outra_moeda" />
        </LinearLayout>
        <TextView android:id="@+id/help" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="?" android:textSize="20sp" android:textColor="@color/white" android:background="@drawable/field_glass" android:contentDescription="@string/ui_sobre_as_cotacoes" android:focusable="true" android:clickable="true" />
      </LinearLayout>
      <LinearLayout android:id="@+id/converterSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_voce_recebe_em_reais" />
        <TextView android:id="@+id/finalResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_r" android:textColor="@color/white" android:textSize="42sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.04" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/resultHint" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_escolha_a_moeda_e_informe_o_valor" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_glass" android:padding="20dp" android:layout_marginTop="28dp">
          <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_voce_converte" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <TextView android:id="@+id/sourceCurrency" android:layout_width="wrap_content" android:layout_height="52dp" android:gravity="center" android:text="@string/ui_us_usd" android:textSize="16sp" android:textColor="@color/white" android:background="@drawable/field_glass" android:clickable="true" android:focusable="true" android:contentDescription="@string/ui_selecionar_moeda_de_origem" android:paddingLeft="14dp" android:paddingRight="14dp" />

            <EditText
                android:id="@+id/addValue"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:gravity="end|center_vertical"
                android:hint="@string/amount_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="18"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:textSize="26sp" />
          </LinearLayout>
          <TextView android:id="@+id/sourceName" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_dolar_americano" />
          <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#46536F" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" />
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="@string/ui_r_14" android:textColor="@color/mint" android:textSize="18sp" android:background="@drawable/circle_glass" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_brl" android:textColor="@color/white" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
              <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_real_brasileiro" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/ui_destino" android:textColor="@color/mint" android:textSize="12sp" android:background="@drawable/badge_mint" />
          </LinearLayout>
          <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnConvert" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="24dp" android:text="@string/ui_converter_agora" android:textAllCaps="false" android:textSize="16sp" android:textColor="@color/white" android:fontFamily="sans-serif-medium" android:background="@drawable/button_violet" android:backgroundTint="@null" android:stateListAnimator="@null" />
          <TextView android:id="@+id/tvUpdatedAt" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/ui_cotacao_comercial_taxas_nao_incluidas" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/marketSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
          <TextView style="@style/Heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_cotacoes" />
          <TextView android:id="@+id/refreshQuotes" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="@string/ui_atualizar" android:textSize="13sp" android:textColor="@color/muted" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:paddingLeft="12dp" android:paddingRight="12dp" />
        </LinearLayout>
        <TextView android:id="@+id/marketStatus" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_valor_de_1_unidade_em_reais" android:layout_marginBottom="14dp" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:id="@+id/quoteList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_toque_em_uma_moeda_para_converter" android:layout_marginTop="4dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/historySection" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_suas_conversoes" android:textSize="28sp" />
        <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_as_ultimas_20_consultas_ficam_neste_aparelho" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/clearHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:text="@string/clear_history_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/field_glass"
            android:backgroundTint="@null"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_cotacoes_fornecidas_pela_awesomeapi_nvalores" android:textSize="11sp" android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:gravity="center" android:layout_marginTop="24dp" />
      <TextView android:id="@+id/developerCredit"
          android:layout_width="match_parent" android:layout_height="wrap_content"
          android:text="@string/developer_credit" android:textSize="12sp"
          android:textColor="@color/muted" android:gravity="center"
          android:layout_marginTop="12dp" />
    </LinearLayout>
  </ScrollView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/panel_glass" android:padding="6dp" android:layout_marginBottom="12dp" android:gravity="center" android:layout_marginLeft="24dp" android:layout_marginRight="24dp">
    <TextView android:id="@+id/navConvert" style="@style/Nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_converter" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/navMarket" style="@style/Nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_cotacoes_28" android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/navHistory" style="@style/Nav" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_historico" android:clickable="true" android:focusable="true" />
  </LinearLayout>
</LinearLayout>