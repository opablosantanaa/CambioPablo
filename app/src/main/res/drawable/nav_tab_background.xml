<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true" android:state_focused="true">
                <shape><solid android:color="@color/primary"/><corners android:radius="999dp"/><stroke android:width="2dp" android:color="@color/accent"/></shape>
            </item>
            <item android:state_selected="true">
                <shape><solid android:color="@color/primary"/><corners android:radius="999dp"/></shape>
            </item>
            <item android:state_focused="true">
                <shape><solid android:color="@android:color/transparent"/><corners android:radius="999dp"/><stroke android:width="2dp" android:color="@color/accent"/></shape>
            </item>
            <item>
                <shape><solid android:color="@android:color/transparent"/><corners android:radius="999dp"/></shape>
            </item>
        </selector>
    </item>
</ripple>